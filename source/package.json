{
  "name": "solo-trpg",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "SoloTRPG — 单人跑团独立运行器（内置规则书/模组/角色卡/战术地图/战斗记录，AI 作为 DM）",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "icon": "node tools/make-icon.mjs",
    "build:exe": "electron-builder --dir --win --x64 --publish never && node tools/verify-package.mjs",
    "sync": "node tools/sync-from-repo.mjs",
    "sync:force": "node tools/sync-from-repo.mjs --force",
    "health": "node tools/health.mjs",
    "smoke": "node tools/smoke-ui.mjs",
    "api": "node tools/dnd-api.mjs",
    "desktop": "node node_modules/electron/install.js && electron .",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "release:local": "node tools/publish-local.mjs",
    "build:release": "npm run build:exe && npm run release:local",
    "build:sea": "node tools/build-exe.mjs",
    "test:desktop": "node --test tools/desktop.test.mjs tools/settings.test.mjs tools/modules.test.mjs tools/theme.test.mjs tools/adventure.test.mjs tools/pdf-maps.test.mjs tools/gameplay.test.mjs tools/markdown.test.mjs tools/battle.test.mjs",
    "build:zip": "npm run build:exe && node tools/publish-local.mjs --stage && node tools/archive-release.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "build": {
    "appId": "com.not1u.dndaidmtools",
    "productName": "SoloTRPG",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "server.mjs",
      "src/**",
      "app/**",
      "engine/*.txt",
      "plugins/*.mjs",
      "LICENSE",
      "NOTICE.md",
      "package.json"
    ],
    "win": {
      "icon": "app/icon.ico",
      "target": [
        "portable"
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SoloTRPG-${version}-Windows-x64.exe"
    },
    "nsis": {
      "artifactName": "SoloTRPG-${version}-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "pdf-parse": "2.4.5",
    "@napi-rs/canvas": "0.1.80"
  }
}
